<odoo>
    <data noupdate="1">

        <record id="ir_cron_auto_close" model="ir.cron">
            <field name="name">SOPROMER : Fermeture automatique des sessions POS</field>
            <field name="model_id" ref="point_of_sale.model_pos_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_close_sessions()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Cron de test : exécution manuelle uniquement (active=False + nextcall
             très lointain). Bypass le check heure via _force_auto_close_all().
             Utilisation : Technique > Actions planifiées > ce cron > "Exécuter
             manuellement" → ferme toutes sessions opened immédiatement + email. -->
        <record id="ir_cron_force_close" model="ir.cron">
            <field name="name">SOPROMER : [TEST] Forcer fermeture sessions POS (manuel)</field>
            <field name="model_id" ref="point_of_sale.model_pos_session"/>
            <field name="state">code</field>
            <field name="code">model._force_auto_close_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(years=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
