<odoo>

    <record id="res_config_settings_view_form_auto_close" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.auto.close</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <block title="Fermeture automatique"
                       name="sopromer_pos_auto_close_block">
                    <setting id="sopromer_pos_auto_close_setting"
                             help="Ferme automatiquement les sessions POS encore ouvertes a l'heure programmee.">
                        <field name="pos_auto_close_enabled"/>
                        <div class="content-group"
                             invisible="not pos_auto_close_enabled">
                            <div class="row mt8">
                                <label for="pos_auto_close_hour_global"
                                       string="Heure (HH)"
                                       class="col-lg-4 o_light_label"/>
                                <field name="pos_auto_close_hour_global"
                                       class="col-lg-2"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_auto_close_minute_global"
                                       string="Minute (MM)"
                                       class="col-lg-4 o_light_label"/>
                                <field name="pos_auto_close_minute_global"
                                       class="col-lg-2"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_auto_close_email_to"
                                       class="col-lg-4 o_light_label"/>
                                <field name="pos_auto_close_email_to"
                                       placeholder="responsable@sopromer.mg, compta@sopromer.mg"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>
